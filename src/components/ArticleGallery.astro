---
import { ChevronLeft, ChevronRight, X, ZoomIn, ZoomOut, RotateCcw } from 'lucide-astro';
---

<dialog class="article-gallery" data-article-gallery aria-labelledby="gallery-heading">
  <header>
    <h2 id="gallery-heading">文章配图</h2>
    <div class="gallery-zoom-tools" role="group" aria-label="图片缩放">
      <button type="button" data-gallery-zoom-out aria-label="缩小图片" disabled><ZoomOut size={18}/></button>
      <span data-gallery-zoom aria-label="缩放比例">100%</span>
      <button type="button" data-gallery-zoom-in aria-label="放大图片" disabled><ZoomIn size={18}/></button>
      <button type="button" data-gallery-reset aria-label="恢复图片大小" disabled><RotateCcw size={18}/></button>
    </div>
    <button type="button" data-gallery-close aria-label="关闭大图"><X size={20} /></button>
  </header>
  <div class="gallery-stage" data-gallery-stage></div>
  <footer>
    <button type="button" data-gallery-prev aria-label="上一张"><ChevronLeft size={20} /></button>
    <p data-gallery-caption aria-live="polite"></p>
    <button type="button" data-gallery-next aria-label="下一张"><ChevronRight size={20} /></button>
  </footer>
  <p class="gallery-help">滚轮或双指缩放 · 放大后拖动 · 双击恢复 · 左右切图</p>
</dialog>

<script>
  import '../scripts/article-gallery';
</script>

<style>
  .article-gallery { width: min(1120px, calc(100% - 28px)); max-width: none; max-height: 94dvh; padding: 16px; overflow: auto; border: 1px solid var(--line); border-radius: 16px; background: var(--surface-solid); color: var(--ink); }
  .article-gallery::backdrop { background: #080e1ce0; }
  header, footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  h2 { font-size: 1rem; }
  button { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  button:disabled { opacity: .45; cursor: default; }
  .gallery-zoom-tools { display: flex; align-items: center; justify-content: center; gap: 6px; margin-left: auto; }
  .gallery-zoom-tools span { min-width: 44px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; }
  .gallery-zoom-tools button { width: 36px; height: 36px; }
  .gallery-stage { position: relative; display: grid; place-items: center; height: min(65dvh, 720px); margin-block: 12px; overflow: hidden; background: var(--page); border: 1px solid var(--line); border-radius: 10px; touch-action: none; user-select: none; }
  .gallery-stage :global(img) { position: absolute; top: 50%; left: 50%; display: block; max-width: none; max-height: none; object-fit: contain; user-select: none; -webkit-user-drag: none; }
  .gallery-stage[data-zoomed='true'] { cursor: grab; }
  .gallery-stage[data-zoomed='true'][data-dragging='true'] { cursor: grabbing; }
  .gallery-help { margin: 9px 0 0; text-align: center; color: var(--muted); font-size: 12px; }
  footer p { text-align: center; color: var(--muted); font-size: 13px; }
  @media(max-width:640px) {
    .article-gallery { padding: 11px; width: calc(100% - 16px); }
    header { flex-wrap: wrap; gap: 7px; }
    header h2 { font-size: 15px; }
    header > button { width: 32px; height: 32px; }
    .gallery-zoom-tools { gap: 3px; }
    .gallery-zoom-tools button { width: 31px; height: 32px; }
    .gallery-zoom-tools span { min-width: 37px; }
    .gallery-stage { height: 57dvh; }
    footer p { font-size: 11px; overflow-wrap: anywhere; }
    footer button { width: 35px; height: 35px; }
    .gallery-help { font-size: 10px; }
  }
</style>
