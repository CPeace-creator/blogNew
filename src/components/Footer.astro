---
import { ArrowUpRight, Github, Mail } from 'lucide-astro';
import { SITE } from '../config';
import { withBase } from '../lib/paths';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-brand" href={withBase('/')}>{SITE.title}</a>
      <p>{SITE.description}</p>
    </div>
    <div class="footer-links">
      <a href={SITE.github} target="_blank" rel="noreferrer">
        <Github size={17} /> GitHub <ArrowUpRight size={14} />
      </a>
      <a href={`mailto:${SITE.email}`}><Mail size={17} /> 联系</a>
    </div>
    <p class="copyright">© {new Date().getFullYear()} {SITE.author} · Powered by Astro</p>
  </div>
</footer>
