---
import { Search, SlidersHorizontal, Sun, Moon, Menu, CloudRain, Sparkles } from 'lucide-astro';
import { Image } from 'astro:assets';
import avatar from '../assets/images/profile-avatar.jpg';
import { SITE } from '../config';
import { withBase } from '../lib/paths';
interface Props { activeSection?: string; }
---
<header class="site-header" data-header>
  <div class="header-inner shell">
    <a class="brand" href={withBase('/')} aria-label={`${SITE.title}首页`}>
      <Image src={avatar} alt="" layout="none" width={34} height={34} widths={[34,68]} sizes="34px" format="webp" quality={80} loading="eager" decoding="async" />
      <span>{SITE.title}</span>
    </a>
    <div class="header-actions">
      <button class="header-tool search-trigger" type="button" data-search-open aria-label="打开搜索"><Search size={19}/></button>
      <button class="header-tool ambient-trigger" type="button" data-open-dialog="ambient-dialog" aria-label="环境雨声"><CloudRain size={19}/></button>
      <button class="header-tool motion-trigger" type="button" data-motion-toggle aria-label="暂停背景动态" aria-pressed="true"><Sparkles size={19}/></button>
      <button class="header-tool" type="button" data-open-dialog="appearance-dialog" aria-label="外观设置"><SlidersHorizontal size={19}/></button>
      <button class="header-tool" type="button" data-theme-toggle aria-label="切换深浅主题"><Sun class="theme-sun" size={20}/><Moon class="theme-moon" size={20}/></button>
      <button class="header-tool" type="button" data-open-dialog="navigation-dialog" aria-label="打开导航"><Menu size={22}/></button>
    </div>
  </div>
</header>
