---
import {ArrowUpRight,BookOpen,CalendarDays,Clock,Pin} from 'lucide-astro';
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import {withBase} from '../lib/paths';
interface Props{post:{id:string;data:{title:string;description:string;publishedAt:Date;category:string;tags:string[];cover:ImageMetadata;coverAlt:string;readingTime:string;featured?:boolean;projectSummary?:{role:string;status:string}}};layout?:'grid'|'row';showProjectSummary?:boolean;coverFit?:'cover'|'contain';}
const {post,showProjectSummary=false,coverFit='cover'}=Astro.props;
const date=new Intl.DateTimeFormat('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}).format(post.data.publishedAt);
---
<article class="post-card theme-card" data-post-card data-category={post.data.category}>
 <a class="post-card-image" href={withBase(`/posts/${post.id}/`)} tabindex="-1" aria-hidden="true"><Image src={post.data.cover} alt="" layout="none" format="webp" quality={80} width={640} height={coverFit==='contain'?undefined:360} fit={coverFit} widths={[320,480,640,960]} sizes={coverFit==='contain'?'(max-width:640px) 120px, (max-width:1199px) 200px, 260px':'(max-width:640px) calc(100vw - 36px), (max-width:1199px) 360px, 460px'} loading="lazy" decoding="async"/></a>
 <div class="post-card-body"><h3><a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a></h3><div class="post-category">{post.data.featured&&<span class="pinned-label"><Pin size={13}/>置顶</span>}<span><BookOpen size={15}/>{post.data.category}</span></div><p>{post.data.description}</p>
 {showProjectSummary&&post.data.projectSummary&&<p class="project-summary">我负责：{post.data.projectSummary.role}</p>}
 <div class="post-meta"><time datetime={post.data.publishedAt.toISOString()}><CalendarDays size={13} style="display:inline;vertical-align:-2px"/> {date}</time><span><Clock size={13} style="display:inline;vertical-align:-2px"/> {post.data.readingTime}</span></div>
 <div class="post-card-foot"><div class="tag-list" aria-label="文章标签">{post.data.tags.slice(0,2).map(tag=><a href={withBase(`/tags/?tag=${encodeURIComponent(tag)}`)}># {tag}</a>)}</div><a class="round-link" href={withBase(`/posts/${post.id}/`)} aria-label={`阅读《${post.data.title}》`}><ArrowUpRight size={16}/></a></div></div>
</article>
