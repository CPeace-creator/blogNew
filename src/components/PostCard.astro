---
import { ArrowUpRight } from 'lucide-astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../lib/paths';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      publishedAt: Date;
      category: string;
      tags: string[];
      cover: ImageMetadata;
      coverAlt: string;
      readingTime: string;
      projectSummary?: { role: string; status: string };
    };
  };
  layout?: 'grid' | 'row';
  showProjectSummary?: boolean;
}

const { post, layout = 'grid', showProjectSummary = false } = Astro.props;
const summary = showProjectSummary ? post.data.projectSummary : undefined;
const date = new Intl.DateTimeFormat('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.publishedAt);
---

<article class:list={['post-card', `post-card--${layout}`, 'glass-card']} data-post-card data-category={post.data.category}>
  <a class="post-card-image" href={withBase(`/posts/${post.id}/`)} tabindex="-1" aria-hidden="true">
    <Image src={post.data.cover} alt="" layout="none" format="webp" quality={78}
      width={640} height={480} fit="cover" widths={[320, 480, 640, 960]}
      sizes="(max-width: 640px) calc(100vw - 36px), (max-width: 980px) 289px, 326px"
      loading="lazy" decoding="async" />
  </a>
  <div class="post-card-body">
    <div class="post-meta">
      <span>{post.data.category}</span>
      <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
      <span>{post.data.readingTime}</span>
    </div>
    <h3><a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    {summary && (
      <div class="project-summary">
        <p><strong>我负责</strong>{summary.role}</p>
        {post.id === 'bim-project-management' && (
          <a class="text-link" href={withBase('/lab/#standard-floor-task')}>试用 BIM 演示 <ArrowUpRight size={15} aria-hidden="true" /></a>
        )}
      </div>
    )}
    <div class="post-card-foot">
      <div class="tag-list" aria-label="文章标签">
        {post.data.tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
      </div>
      <a class="round-link" href={withBase(`/posts/${post.id}/`)} aria-label={`阅读《${post.data.title}》`}>
        <ArrowUpRight size={19} />
      </a>
    </div>
  </div>
</article>

<style>
  .project-summary { display: grid; gap: 6px; margin-top: 8px; }
  .project-summary p { color: var(--ink); font-size: 13px; }
  .project-summary strong { margin-right: .55em; color: var(--ink-strong); }
  .project-summary a { justify-self: start; }
</style>
