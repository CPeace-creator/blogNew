---
import { X, Palette, Image as ImageIcon, Settings2, Home, FolderKanban, BookOpen, Archive, FlaskConical, Tags, UserRound, Layers, ArrowUp, List, CloudRain, Play, Upload, RotateCcw, Mail, Github, Flower2 } from 'lucide-astro';
import { SITE } from '../config';
import { withBase } from '../lib/paths';
interface Props { reading?:boolean; }
const {reading=false}=Astro.props;
const routes=[['主页','/',Home],['工作室','/#studio',Flower2],['项目','/projects/',FolderKanban],['技术笔记','/notes/',BookOpen],['实验室','/lab/',FlaskConical],['文章归档','/archive/',Archive],['分类','/categories/',Layers],['标签','/tags/',Tags],['关于我','/about/',UserRound]] as const;
---
<dialog class="appearance-dialog theme-dialog" id="appearance-dialog" aria-labelledby="appearance-heading">
 <header class="dialog-heading"><h2 id="appearance-heading">外观设置</h2><button type="button" data-close-dialog aria-label="关闭外观设置"><X size={19}/></button></header>
 <nav class="appearance-tabs" role="tablist" aria-label="外观设置分类"><button type="button" role="tab" id="tab-look" aria-controls="panel-look" aria-selected="true" data-appearance-tab="look"><Palette size={16}/> 外观</button><button type="button" role="tab" id="tab-wallpaper" aria-controls="panel-wallpaper" aria-selected="false" tabindex="-1" data-appearance-tab="wallpaper"><ImageIcon size={16}/> 壁纸</button><button type="button" role="tab" id="tab-preferences" aria-controls="panel-preferences" aria-selected="false" tabindex="-1" data-appearance-tab="preferences"><Settings2 size={16}/> 偏好</button></nav>
 <div class="appearance-content">
 <section role="tabpanel" id="panel-look" aria-labelledby="tab-look" data-appearance-panel="look">
  <h3 class="widget-title">站点布局</h3><div class="setting-grid"><button type="button" class="layout-choice" data-setting="layout" data-value="cards"><span class="layout-preview layout-preview--cards"><i></i><i></i><i></i></span><strong>壁纸与卡片</strong><small>个人侧栏 · 圆角卡片</small></button><button type="button" class="layout-choice" data-setting="layout" data-value="focus"><span class="layout-preview layout-preview--focus"><i></i><i></i></span><strong>专注阅读</strong><small>简洁排版 · 更少干扰</small></button></div>
  <h3 class="widget-title">字体样式</h3><div class="setting-grid"><button type="button" data-setting="font" data-value="system">默认字体</button><button type="button" data-setting="font" data-value="wenkai">霞鹜文楷</button></div>
  <h3 class="widget-title">主题颜色</h3><div class="theme-mode-choices"><button type="button" data-setting="theme" data-value="light">亮色</button><button type="button" data-setting="theme" data-value="dark">暗色</button><button type="button" data-setting="theme" data-value="system">跟随系统</button></div>
  <label class="setting-range">自定义色相 <output data-hue-value>210</output><input type="range" min="0" max="360" value="210" data-hue-input aria-label="主题色相"/></label>
  <div class="hue-presets"><button type="button" data-hue-preset="210" style="--swatch:#6aa7db" aria-label="晴空蓝"></button><button type="button" data-hue-preset="340" style="--swatch:#e79ab7" aria-label="樱花粉"></button><button type="button" data-hue-preset="160" style="--swatch:#76bca8" aria-label="薄荷绿"></button><button type="button" data-hue-preset="265" style="--swatch:#a18bd0" aria-label="淡紫色"></button></div>
  <h3 class="widget-title">卡片装饰</h3><div class="setting-grid"><button type="button" data-setting="cards" data-value="border">轻薄边框<small>浅色描边，清爽留白</small></button><button type="button" data-setting="cards" data-value="soft">柔和光晕<small>淡淡主题色与阴影</small></button></div>
 </section>
 <section role="tabpanel" id="panel-wallpaper" aria-labelledby="tab-wallpaper" data-appearance-panel="wallpaper" hidden>
  <h3 class="widget-title">壁纸模式</h3><div class="setting-grid"><button type="button" data-setting="wallpaper" data-value="banner">横幅壁纸<small>欢迎页展示，正文简洁</small></button><button type="button" data-setting="wallpaper" data-value="full">全屏壁纸<small>壁纸延续到整个页面</small></button><button type="button" data-setting="wallpaper" data-value="transparent">全屏透明<small>半透明卡片与背景融合</small></button><button type="button" data-setting="wallpaper" data-value="solid">纯色背景<small>保持安静，专注内容</small></button></div>
  <h3 class="widget-title">选择壁纸</h3><div class="wallpaper-choices"><button type="button" data-setting="image" data-value="stars"><span class="wallpaper-thumb wallpaper-thumb--stars"></span>星河听风</button><button type="button" data-setting="image" data-value="cherry"><span class="wallpaper-thumb wallpaper-thumb--cherry"></span>夜樱河岸</button><button type="button" data-setting="image" data-value="sky"><span class="wallpaper-thumb wallpaper-thumb--sky"></span>晴日樱花</button></div>
  <label class="setting-range">壁纸遮罩 <output data-dim-value>18%</output><input type="range" min="0" max="65" value="18" data-wallpaper-dim aria-label="壁纸遮罩强度"/></label>
  <label class="upload-wallpaper"><Upload size={16}/> 使用自己的壁纸<input type="file" accept="image/jpeg,image/png,image/webp" data-wallpaper-file/></label><p class="settings-help">图片仅保存在当前浏览器，支持 JPG、PNG、WebP，最大 8 MB。</p><p class="settings-status" data-wallpaper-status role="status"></p>
  <button class="reset-wallpaper" type="button" data-reset-wallpaper><RotateCcw size={15}/> 清除自定义壁纸</button>
 </section>
 <section role="tabpanel" id="panel-preferences" aria-labelledby="tab-preferences" data-appearance-panel="preferences" hidden>
  <h3 class="widget-title">导航栏</h3><div class="setting-grid"><button type="button" data-setting="nav" data-value="flow">随页面滚动<small>正文不被顶部导航遮挡</small></button><button type="button" data-setting="nav" data-value="smart">智能收起<small>下滚隐藏，上滚出现</small></button></div>
  <h3 class="widget-title">背景动态</h3><div class="setting-grid"><button type="button" data-setting="motion" data-value="on">开启动态</button><button type="button" data-setting="motion" data-value="off">减少动态</button></div>
  <h3 class="widget-title">正文字号</h3><label class="setting-range">阅读文字大小 <output data-font-size-value>18 px</output><input type="range" min="16" max="22" value="18" data-font-size aria-label="正文字号"/></label>
  <p class="settings-help">设置会保存在当前浏览器，重新打开页面仍然生效。</p><button class="reset-settings" type="button" data-reset-settings><RotateCcw size={15}/> 恢复默认外观</button>
 </section>
 </div>
</dialog>
<dialog class="navigation-dialog theme-dialog" id="navigation-dialog" aria-labelledby="navigation-heading"><header class="dialog-heading"><h2 id="navigation-heading">去哪里逛逛？</h2><button type="button" data-close-dialog aria-label="关闭导航"><X size={20}/></button></header><nav class="menu-links" aria-label="主导航">{routes.map(([label,href,Icon])=><a href={withBase(href)}><Icon size={20}/><span>{label}</span></a>)}</nav><div class="menu-contact"><a href={SITE.github} target="_blank" rel="noreferrer"><Github size={17}/> GitHub</a><a href={`mailto:${SITE.email}`}><Mail size={17}/> 联系我</a></div></dialog>
<dialog class="ambient-dialog theme-dialog" id="ambient-dialog" aria-labelledby="ambient-heading"><header class="dialog-heading"><h2 id="ambient-heading"><CloudRain size={20}/> 听一会儿雨</h2><button type="button" data-close-dialog aria-label="关闭雨声面板"><X size={19}/></button></header><div class="ambient-visual" aria-hidden="true"><CloudRain size={62}/><i></i><i></i><i></i></div><p>留一点安静，给阅读和思考。</p><button type="button" class="ambient-play" data-ambient-play aria-pressed="false"><Play size={18}/><span>播放雨声</span></button><label class="setting-range">音量<input type="range" min="0" max="100" value="18" data-ambient-volume aria-label="雨声音量"/></label><p class="settings-help" data-ambient-status>点击后播放本地合成的环境雨声。</p></dialog>
{reading&&<dialog class="outline-dialog theme-dialog" id="outline-dialog" aria-labelledby="outline-heading"><header class="dialog-heading"><h2 id="outline-heading">文章目录</h2><button type="button" data-close-dialog aria-label="关闭文章目录"><X size={20}/></button></header><nav data-mobile-outline aria-label="移动端文章目录"></nav></dialog>}
<nav class="reading-tools" aria-label="阅读工具"><button type="button" class="reading-meter" data-scroll-top aria-label="阅读进度 0%，返回顶部"><span data-reading-percent>0%</span></button>{reading&&<button type="button" data-open-dialog="outline-dialog" aria-label="打开文章目录"><List size={20}/></button>}<a href={withBase('/')} aria-label="返回主页"><Home size={19}/></a><button type="button" data-scroll-top aria-label="返回顶部"><ArrowUp size={19}/></button></nav>
