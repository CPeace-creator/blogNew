---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import ThemeBackdrop from '../components/ThemeBackdrop.astro';
import ThemeControls from '../components/ThemeControls.astro';
import MoonCompanion from '../components/MoonCompanion.astro';
import SiteMusic from '../components/SiteMusic.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config';
import { withBase } from '../lib/paths';
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/effects.css';
import '../styles/studio-embed.css';
interface Props {
 title?:string;description?:string;image?:string;reading?:boolean;home?:boolean;activeSection?:string;
 posts?:Array<{id:string;data:{title:string;description:string;category:string;tags:string[]}}>;
}
const {title,description=SITE.description,image,reading=false,home=false,activeSection,posts=[]}=Astro.props;
const pageTitle=title?`${title} | ${SITE.title}`:`${SITE.title} | 个人博客`;
const canonical=new URL(Astro.url.pathname,Astro.site);
const searchPosts=posts.map(({id,data})=>({id,...data}));
---
<!doctype html>
<html lang="zh-CN" data-blog-theme data-reading-page={reading||undefined} data-home-page={home||undefined}>
 <head>
  <ClientRouter/>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="generator" content={Astro.generator}/><meta name="description" content={description}/><meta name="theme-color" content="#f7f9fc"/>
  <link rel="icon" href={withBase('/xiangjiang-tab.ico')} sizes="16x16 32x32 48x48"/><link rel="icon" href={withBase('/xiangjiang-tab.png')} type="image/png" sizes="32x32"/>
  <link rel="canonical" href={canonical}/><meta property="og:type" content={reading?'article':'website'}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/>{image&&<meta property="og:image" content={new URL(image,Astro.site)}/>}<title>{pageTitle}</title>
  <script is:inline>
   if(window.self!==window.top&&new URLSearchParams(location.search).get('studio-embed')==='1')document.documentElement.dataset.studioEmbed='true';
   (()=>{const r=document.documentElement;let p={};try{p=JSON.parse(localStorage.getItem('xiangjiang-appearance')||'{}');if(!p.theme)p.theme=localStorage.getItem('theme')||'light';}catch{}const values={layout:'cards',font:'wenkai',wallpaper:'banner',image:'stars',cards:'border',nav:'flow',motion:'on'};for(const [k,v]of Object.entries(values))r.dataset[k]=typeof p[k]==='string'?p[k]:v;const m=p.theme||'light';r.dataset.theme=m==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):m;r.style.setProperty('--hue',String(Math.max(0,Math.min(360,Number(p.hue)||210))));r.style.setProperty('--reading-size',`${Math.max(16,Math.min(22,Number(p.fontSize)||18))}px`);r.style.setProperty('--wallpaper-dim',String(Math.max(0,Math.min(.65,Number(p.dim??.18)))));try{const image=localStorage.getItem('xiangjiang-wallpaper');if(image&&/^data:image\/(webp|png|jpeg);base64,/.test(image))r.style.setProperty('--custom-wallpaper',`url("${image}")`);}catch{}})();
  </script>
 </head>
 <body id="site-top">
  <a class="skip-link" href="#main">跳到正文</a><ThemeBackdrop home={home}/><Header activeSection={activeSection}/>
  <main id="main" tabindex="-1"><slot/></main><Footer/><SearchDialog posts={searchPosts}/><ThemeControls reading={reading}/>
  <SiteMusic/><MoonCompanion posts={posts}/>
  <script>import '../scripts/theme';</script>
  <script>import '../scripts/site-effects';</script>
 </body>
</html>
