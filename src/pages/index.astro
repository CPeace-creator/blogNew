---
import { getCollection } from 'astro:content';
import { ArrowDown, ArrowRight, CalendarDays, Sparkles } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import { SITE } from '../config';
import { withBase } from '../lib/paths';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const categories = ['全部', ...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout posts={posts}>
  <section class="home-hero" aria-labelledby="hero-title">
    <img src={withBase('/images/hero-japan.webp')} alt="夜晚盛开的樱花与河岸灯光" width="2400" height="1500" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="petals" aria-hidden="true">
      {Array.from({ length: 12 }).map((_, index) => <i style={`--i:${index}`}></i>)}
    </div>
    <div class="hero-content shell">
      <p class="hero-badge"><Sparkles size={15} /> CHEN JIAHONG'S PERSONAL SPACE</p>
      <h1 id="hero-title">{SITE.title}</h1>
      <p class="hero-intro">记录技术实践、项目复盘，也记录每一个认真生活的日子。</p>
      <a class="hero-link" href="#latest">进入我的世界 <ArrowDown size={18} /></a>
    </div>
    <button class="petals-toggle glass-panel" type="button" data-petals-toggle><Sparkles size={17} /><span>关闭花瓣</span></button>
    <div class="hero-wave" aria-hidden="true"></div>
  </section>

  <div class="home-surface" id="latest">
    <div class="dashboard shell">
      <div class="main-feed">
        <section class="welcome-strip glass-card">
          <div class="welcome-icon"><Sparkles size={22} /></div>
          <div><strong>欢迎回来</strong><p>今天也要保持热爱，认真生活。</p></div>
          <div class="welcome-date"><CalendarDays size={16} /><span>{new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', weekday: 'short' }).format(new Date())}</span></div>
        </section>

        <section class="content-section" aria-labelledby="latest-heading">
          <div class="section-heading">
            <div><p class="section-kicker">LATEST POSTS</p><h2 id="latest-heading">最近更新</h2></div>
            <a class="text-link" href={withBase('/archive/')}>全部文章 <ArrowRight size={17} /></a>
          </div>
          <div class="category-tabs" role="tablist" aria-label="按分类筛选">
            {categories.map((category, index) => (
              <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-category-filter={category}>{category}</button>
            ))}
          </div>
          <div class="posts-grid" data-posts-grid>
            {posts.map((post) => <PostCard post={post} layout="row" />)}
          </div>
          <p class="filter-empty" data-filter-empty hidden>这个分类暂时还没有文章。</p>
        </section>
      </div>
      <ProfileSidebar posts={posts} />
    </div>
  </div>

  <script>
    const filterButtons = document.querySelectorAll('[data-category-filter]');
    const cards = document.querySelectorAll('[data-post-card]');
    const empty = document.querySelector('[data-filter-empty]');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category-filter');
        let visible = 0;
        filterButtons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
        cards.forEach((card) => {
          const show = category === '全部' || card.getAttribute('data-category') === category;
          card.toggleAttribute('hidden', !show);
          if (show) visible += 1;
        });
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      });
    });
  </script>
</BaseLayout>
