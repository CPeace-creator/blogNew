---
import {getCollection} from 'astro:content';
import {Image} from 'astro:assets';
import {ArrowDown,BookOpen,Box,Github,Mail,Rss,Sparkles} from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentShell from '../components/ContentShell.astro';
import PostCard from '../components/PostCard.astro';
import avatar from '../assets/images/profile-avatar.jpg';
import {SITE} from '../config';
import {withBase} from '../lib/paths';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||+b.data.publishedAt-+a.data.publishedAt);
const categories=['全部',...new Set(posts.map(p=>p.data.category))];
---
<BaseLayout posts={posts} home>
 <section class="landing-hero" aria-labelledby="hero-title">
  <div class="landing-center">
   <div class="landing-profile"><span class="landing-tape" aria-hidden="true"></span><span class="landing-sticker landing-sticker--left" aria-hidden="true"><BookOpen size={32}/></span><span class="landing-sticker landing-sticker--right" aria-hidden="true"><Box size={32}/></span>
    <Image class="landing-avatar" src={avatar} alt="陈嘉鸿的头像" layout="none" width={96} height={96} widths={[96,192]} sizes="76px" format="webp" quality={82} loading="eager" decoding="async"/>
    <span class="landing-author">{SITE.author}</span><h1 id="hero-title">{SITE.title}</h1><p>把项目里的问题，写成能回看的记录。</p>
    <nav class="landing-links" aria-label="欢迎页导航"><a href="#articles">文章</a><a href={withBase('/projects/')}>项目</a><a href={withBase('/lab/')}>实验室</a><a href={withBase('/about/')}>关于</a></nav><span class="landing-note" aria-hidden="true">欢迎来访</span>
   </div>
   <div class="landing-socials"><a href={SITE.github} target="_blank" rel="noreferrer" aria-label="GitHub"><Github size={19}/></a><a href={withBase('/lab/')} aria-label="实验室"><Box size={19}/></a><a href={`mailto:${SITE.email}`} aria-label="邮件"><Mail size={19}/></a><a href={withBase('/rss.xml')} aria-label="RSS 订阅"><Rss size={19}/></a></div>
  </div>
  <a class="landing-scroll" href="#articles" aria-label="向下阅读文章"><ArrowDown size={32}/></a><div class="landing-wave" aria-hidden="true"></div>
 </section>
 <section class="home-content" id="articles" aria-label="最新文章">
  <ContentShell posts={posts} active="/" wide>
   <div class="feed-heading theme-card"><h2><Sparkles size={16} style="display:inline;vertical-align:-2px;color:var(--accent)"/> 在这里，慢慢记录</h2><span data-feed-count>共 {posts.length} 篇文章</span></div>
   <div class="feed-filters" aria-label="按分类筛选文章">{categories.map((category,i)=><button type="button" data-feed-category={category} aria-pressed={i===0?'true':'false'}>{category}</button>)}</div>
   <div class="feed-grid" data-feed-grid>{posts.map((post,i)=><div data-feed-entry data-category={post.data.category} hidden={i>=6}><PostCard post={post}/></div>)}</div>
   <p class="empty-card theme-card" data-feed-empty hidden>这个分类暂时没有文章。</p><nav class="pagination" data-feed-pagination aria-label="文章分页"></nav>
  </ContentShell>
 </section>
 <script>import '../scripts/feed';</script>
</BaseLayout>
