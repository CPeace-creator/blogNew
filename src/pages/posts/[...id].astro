---
import {getCollection,render,type CollectionEntry} from 'astro:content';
import {Image,getImage} from 'astro:assets';
import {BookOpen,CalendarDays,Clock,Hash,AlignLeft,Link as LinkIcon,ArrowUp,ArrowUpRight,Sparkles,Mail} from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentShell from '../../components/ContentShell.astro';
import ArticleGallery from '../../components/ArticleGallery.astro';
import ArticleVideo from '../../components/ArticleVideo.astro';
import BridgeComparison from '../../components/BridgeComparison.astro';
import {withBase} from '../../lib/paths';
import {SITE} from '../../config';
export async function getStaticPaths(){const posts=await getCollection('blog',({data})=>!data.draft);return posts.map(post=>({params:{id:post.id},props:{post,posts}}));}
interface Props{post:CollectionEntry<'blog'>;posts:CollectionEntry<'blog'>[];}
const {post,posts}=Astro.props;
const {Content,headings}=await render(post);
const showBridgeDemo=post.id==='bim-project-management';
const articleVideos=[...post.data.demoVideos,...(post.data.demoVideo?[post.data.demoVideo]:[])].map((video,index)=>({video,headingId:index===0?'article-video-title':`article-video-title-${index+1}`}));
const toc=headings.filter(h=>h.depth===2||h.depth===3);
if(showBridgeDemo)toc.push({depth:2,slug:'article-demo-title',text:'动手看看进度视图'});
for(const {video,headingId} of articleVideos)toc.push({depth:2,slug:headingId,text:video.title});
let number=0;const outline=toc.map(h=>({...h,number:h.depth===2?String(++number):'·'}));
const related=post.data.relatedPosts.map(id=>posts.find(p=>p.id===id)).filter((p):p is CollectionEntry<'blog'>=>Boolean(p));
const coverWidth=Math.min(1200,post.data.cover.width);
const social=await getImage({src:post.data.cover,width:Math.min(1200,coverWidth),format:'webp',quality:78});
const wordCount=(post.body||'').replace(/\s/g,'').length;
const formatDate=(d:Date)=>new Intl.DateTimeFormat('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}).format(d);
const section=post.id==='about-me'?'/about/':post.data.category==='项目'?'/projects/':['技术笔记','技术成长'].includes(post.data.category)?'/notes/':'/archive/';
---
<BaseLayout title={post.data.title} description={post.data.description} image={social.src} posts={posts} reading activeSection={section}>
 <ContentShell posts={posts} active={section} reading>
  <section class="article-summary theme-card"><h2><Sparkles size={15}/> 文章导读</h2><p>{post.data.description}</p></section>
  <article class="article-page prose theme-card" id="article-top" data-article-body>
   <header class="article-header"><div class="article-word-count"><span><AlignLeft size={15}/> 约 {wordCount.toLocaleString('zh-CN')} 字</span><span><Clock size={15}/> {post.data.readingTime}</span></div><h1 id="article-title">{post.data.title}</h1><div class="article-meta"><time datetime={post.data.publishedAt.toISOString()}><CalendarDays size={16}/>{formatDate(post.data.publishedAt)}</time>{post.data.updatedAt&&<time datetime={post.data.updatedAt.toISOString()} title="更新日期"><CalendarDays size={16}/>{formatDate(post.data.updatedAt)}</time>}<a href={withBase(`/categories/?category=${encodeURIComponent(post.data.category)}`)}><BookOpen size={16}/>{post.data.category}</a></div><div class="article-tags"><Hash size={16} style="color:var(--accent-strong)"/>{post.data.tags.map(tag=><a href={withBase(`/tags/?tag=${encodeURIComponent(tag)}`)}>{tag}</a>)}</div><div class="article-cover"><Image src={post.data.cover} alt={post.data.coverAlt} layout="none" width={coverWidth} widths={[...new Set([320,640,960,coverWidth])].filter(w=>w<=coverWidth)} sizes="(max-width:900px) calc(100vw - 72px), 720px" format="webp" quality={82} loading="eager" decoding="async"/></div></header>
   {post.data.projectSummary&&<div class="case-summary"><dl><dt>我负责</dt><dd>{post.data.projectSummary.role}</dd><dt>目前能做什么</dt><dd>{post.data.projectSummary.status}</dd></dl>{showBridgeDemo&&<a href={withBase('/lab/#standard-floor-task')}>试用 BIM 演示 <ArrowUpRight size={14}/></a>}</div>}
   {outline.length>0&&<details class="article-mobile-toc"><summary>文章目录</summary><nav aria-label="文章目录">{outline.map(h=><a href={`#${h.slug}`} data-level={h.depth}>{h.text}</a>)}</nav></details>}
   <Content/>
   {showBridgeDemo&&<section class="article-demo" aria-labelledby="article-demo-title"><h2 id="article-demo-title">动手看看进度视图</h2><BridgeComparison/><p><a href={withBase('/lab/#standard-floor-task')}>去实验室查一条落后部位的进度记录 →</a></p></section>}
   {articleVideos.map(({video,headingId})=><ArticleVideo video={video} cover={post.data.cover} headingId={headingId}/>)}
   <div class="article-reading-actions" data-reading-end><a href="#site-top"><ArrowUp size={15}/> 返回文章开头</a><button class="copy-link" type="button" data-copy-link><LinkIcon size={15}/><span>复制链接</span></button></div>
   {related.length>0&&<section class="article-related" aria-labelledby="related-heading"><h2 id="related-heading">接着读</h2><ul>{related.map(entry=><li><a href={withBase(`/posts/${entry.id}/`)}>{entry.data.title} <ArrowUpRight size={14} style="display:inline"/></a><p>{entry.data.description}</p></li>)}</ul></section>}
  </article>
  <section class="post-discussion theme-card"><h2>聊聊这篇文章</h2><p>如果你也遇到过类似的问题，欢迎告诉我你的想法。</p><a href={`mailto:${SITE.email}?subject=${encodeURIComponent(`关于《${post.data.title}》`)}`}><Mail size={16}/> 通过邮件交流</a></section>
  <aside slot="rail" class="article-aside theme-card"><h2 class="widget-title">文章目录</h2><nav aria-label="文章目录" data-article-toc>{outline.map(h=><a href={`#${h.slug}`} title={h.text} aria-label={h.text} data-level={h.depth}><span class="toc-number" aria-hidden="true">{h.number}</span><span>{h.text}</span></a>)}</nav><div class="article-aside-actions"><a href="#site-top">↑ 返回开头</a><button class="copy-link" type="button" data-copy-link><LinkIcon size={14}/><span>复制链接</span></button></div></aside>
 </ContentShell>
 <ArticleGallery/>
 <script>
import { onPageMount } from '../../lib/page-lifecycle';

onPageMount(scope => {

  const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-article-toc] a')];const sections=links.map(link=>({link,heading:document.getElementById(decodeURIComponent(link.hash.slice(1)))})).filter(p=>p.heading).reverse();let frame=0,active:HTMLAnchorElement|undefined;
  const update=()=>{frame=0;const current=sections.find(p=>p.heading!.getBoundingClientRect().top<=85)?.link;if(current!==active){active?.removeAttribute('aria-current');current?.setAttribute('aria-current','location');active=current;}};
  const request=()=>{if(!frame)frame=scope.requestAnimationFrame(update);};addEventListener('scroll',request,scope.options({passive:true}));addEventListener('resize',request,scope.options({passive:true}));request();
  document.querySelectorAll<HTMLHeadingElement>('.prose h2[id],.prose h3[id]').forEach(heading=>{if(heading.closest('.article-related')||heading.querySelector('.heading-anchor'))return;const link=document.createElement('a');link.className='heading-anchor';link.href=`#${heading.id}`;link.textContent='#';link.setAttribute('aria-label',`链接到 ${heading.textContent}`);heading.append(link);});
  document.querySelectorAll('.article-mobile-toc a').forEach(link=>link.addEventListener('click',()=>{const menu=link.closest('details');if(menu)menu.open=false;}, scope.options()));
});
</script>
</BaseLayout>
